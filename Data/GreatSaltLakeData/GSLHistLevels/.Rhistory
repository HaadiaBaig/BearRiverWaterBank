library(dataRetrieval)
library(lubridate)
library(dplyr)
library(reshape2)
library(ggplot2)
#Remove unnecessary columns
r <- r[,-5]
#Download daily data water year 2000- 2025
data <- readNWISdv(
"10010000", "00060",
"1999-01-01", "2025-12-30")
View(data)
#Download daily data water year 2000- 2025
data <- readNWISdv(  "10010000", "62614",
"1999-01-01", "2025-12-30")
View(data)
#Remove unnecessary columns
data <- data[,-5]
#Rename
colnames(r)[4] <- "LakeLevel"
#Rename
colnames(data)[4] <- "LakeLevel"
data$year = year(data$Date)
data$yday <- yday(data$Date)
data$month <- month(data$Date)
data<- data %>%
mutate(wateryear = case_when(
lubridate::month(Date) %in% 10:12 ~ year + 1,
TRUE ~ year))
#Download daily data water year 2000- 2025
data <- readNWISdv(  "10010000", "62614",
"1999-01-01", "2025-12-30")
View(data)
#Remove unnecessary columns
data <- data[,-5]
data <- data[,-1]
#Rename
colnames(data)[4] <- "LakeLevel(ft)"
#Rename
colnames(data)[3] <- "LakeLevel(ft)"
write.csv(data, "GSL.csv")
