library(dataRetrieval)
library(lubridate)
library(dplyr)
library(reshape2)
library(ggplot2)
library(tidyr)
library(readr)
#Download daily data water year 2000- 2025
data <- readNWISdv(  "10010000", "62614",
"1999-01-01", "2023-12-30")
View(data)
View(data)
#Remove unnecessary columns
data <- data[,-c(2,3,5)]
#Download daily data water year 2000- 2025
data <- readNWISdv(  "10010000", "62614",
"1999-01-01", "2023-12-30")
View(data)
#Remove unnecessary columns
data <- data[,-c(1,3,5)]
View(data)
#Download daily data water year 2000- 2025
data <- readNWISdv(  "10010000", "62614",
"1999-01-01", "2023-12-30")
View(data)
#Remove unnecessary columns
r <- data[,-c(1,2,5)]
View(r)
#Rename
colnames(r)[2] <- "LakeLevel(ft)"
write.csv(r, "GSLHistorical.csv")
monthly <- r %>%
mutate(Date = as.Date(Date)) %>%
arrange(Date) %>%
group_by(
Year = year(Date),
Month = month(Date)
) %>%
slice_min(Date, n = 1, with_ties = FALSE) %>%
ungroup() %>%
select(Date, `LakeLevel(ft)`)
View(monthly)
write.csv(monthly, "GSLHistMonthly")
write.csv(monthly, "GSLHistMonthly.csv")
# Keep only October 1st lake levels
Oct_levels <- r %>%
mutate(Date = as.Date(Date)) %>%
filter(month(Date) == 10, day(Date) == 1) %>%
arrange(Date) %>%
select(Date, `LakeLevel(ft)`)
View(Oct_levels)
write.csv(Oct_levels, "GSL_Oct.csv")
library(dataRetrieval)
library(lubridate)
library(dplyr)
library(readr)
#Download daily data water year 2000- 2025
data <- readNWISdv(  "10010000", "62614",
"1980-01-01", "2023-12-30")
#Remove unnecessary columns
r <- data[,-c(1,2,5)]
#Rename
colnames(r)[2] <- "LakeLevel(ft)"
View(r)
View(r)
write.csv(r, "GSLHistorical.csv")
